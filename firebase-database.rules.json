            ".validate": "$pedidoId.matches(/^[-A-Za-z0-9_]{8,40}$/) && newData.hasChildren(['ts','codigo','cliente','tipo','pagamento','itens','status']) && (data.exists() || (root.child('caixa/pedidosConfig').child($lojaId).child('aberto').val() === true && (root.child('caixa/pedidosConfig').child($lojaId).child('horarioOn').val() !== true || ((root.child('caixa/pedidosConfig').child($lojaId).child('abreMin').val() < root.child('caixa/pedidosConfig').child($lojaId).child('fechaMin').val() && (((now - 10800000) % 86400000) / 60000) >= root.child('caixa/pedidosConfig').child($lojaId).child('abreMin').val() && (((now - 10800000) % 86400000) / 60000) < root.child('caixa/pedidosConfig').child($lojaId).child('fechaMin').val()) || (root.child('caixa/pedidosConfig').child($lojaId).child('abreMin').val() > root.child('caixa/pedidosConfig').child($lojaId).child('fechaMin').val() && ((((now - 10800000) % 86400000) / 60000) >= root.child('caixa/pedidosConfig').child($lojaId).child('abreMin').val() || (((now - 10800000) % 86400000) / 60000) < root.child('caixa/pedidosConfig').child($lojaId).child('fechaMin').val())))))) && (newData.child('tipo').val() !== 'entrega' || newData.child('endereco').child('rua').exists())",
