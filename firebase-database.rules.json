          },
          "segredo": {
            ".validate": "newData.isString() && newData.val().length <= 200"
          },
          "$outro": {
            ".validate": "false"
          }
        }
      },
      "motoqueirosUid": {
        "$uid": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && (auth.token.email == 'selectsabor24@gmail.com' || root.child('caixa/usuarios/' + auth.uid + '/ativo').val() == true)",
          ".validate": "newData.val() == null || (newData.hasChildren(['lojaId','nome','ativo']) && newData.child('lojaId').isString() && newData.child('ativo').isBoolean())"
        }
      },
      "recusasEntrega": {
        "$lojaId": {
          ".read": "auth != null && (auth.token.email == 'selectsabor24@gmail.com' || root.child('caixa/usuarios/' + auth.uid + '/ativo').val() == true)",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('caixa/motoqueirosUid/' + auth.uid + '/lojaId').val() === $lojaId",
            "$pedidoId": {
              ".write": "(auth != null && root.child('caixa/motoqueirosUid/' + auth.uid + '/ativo').val() === true && root.child('caixa/motoqueirosUid/' + auth.uid + '/lojaId').val() === $lojaId) && auth.uid === $uid && $pedidoId.matches(/^[-A-Za-z0-9_]{8,40}$/)",
              ".validate": "newData.val() === null || newData.isNumber()"
            }
          }
        }
      },
      "cardapioFotos": {
        "$lojaId": {
          ".read": true,
          "$itemId": {
            ".write": "auth != null && (auth.token.email == 'selectsabor24@gmail.com' || root.child('caixa/usuarios/' + auth.uid + '/ativo').val() == true)",
            ".validate": "newData.val() === null || (newData.isString() && newData.val().beginsWith('data:image/') && newData.val().length <= 70000)"
          }
        }
      }
    }
  }
}